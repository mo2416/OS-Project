# Kernel config fragment for the sched_ext test VM (merged on top of
# x86_64_defconfig + kernel/configs/kvm_guest.config). See vm/build_kernel.sh.
# --- sched_ext requirements (tools/sched_ext/README.md) ---
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y
CONFIG_PAHOLE_HAS_BTF_TAG=y
CONFIG_SCHED_CLASS_EXT=y
# --- scheduler observability ---
CONFIG_SCHEDSTATS=y
CONFIG_SCHED_INFO=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_TASKSTATS=y
CONFIG_PERF_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_BPF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_MAGIC_SYSRQ=y
# --- boot the host root filesystem over virtio-9p (read-only) ---
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_CGROUPS=y
# --- keep the build lean ---
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_WLAN=n
CONFIG_MODULES=n
